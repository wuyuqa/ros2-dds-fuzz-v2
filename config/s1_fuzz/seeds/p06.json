{
  "seed_id": "P06",
  "version": 1,
  "surface_refs": [
    "P06"
  ],
  "target_family": "builtin.discovery_projection_reconciliation",
  "capability": {
    "status": "authored",
    "f1_routable": true,
    "runtime_binding": "projection.qos_profile",
    "note": "template only; lease configuration projection is not lease lifecycle coverage"
  },
  "status": "authored",
  "logical_config": {
    "topic": "/r2f/s1/projection_lease",
    "message_type": "std_msgs/msg/String",
    "qos": {
      "reliability": "reliable",
      "durability": "volatile",
      "depth": 64,
      "deadline_ns": 1250000000,
      "liveliness": "automatic",
      "liveliness_lease_duration_ns": 1000000000
    },
    "special_value_classes": {
      "zero": {
        "liveliness_lease_duration_ns": 0
      },
      "finite": {
        "liveliness_lease_duration_ns": 1000000000
      },
      "infinite": {
        "liveliness_lease_duration_ns": 9223372036854775807
      }
    },
    "pre_match_count": 2,
    "post_match_count": 6,
    "publish_interval_sec": 0.03,
    "match_timeout_sec": 8.0,
    "delivery_timeout_sec": 5.0,
    "startup_timeout_sec": 10.0
  },
  "operation_windows": [
    {
      "step": "create_writer",
      "window": "setup"
    },
    {
      "step": "create_reader",
      "window": "setup"
    },
    {
      "step": "observe_projection",
      "window": "endpoint_projection_window",
      "projection_surface": "P06",
      "requires": [
        "endpoint_submitted_qos",
        "endpoint_observed_qos",
        "observer_completeness"
      ]
    }
  ],
  "provenance": {
    "kind": "template",
    "source": "plan 3.1/4 P06 lease duration classes zero/finite/infinite; existing projection_pair QoS schema",
    "derived_from_execution": false
  },
  "capability_requirements": {
    "tools": [
      "public_ros2_api"
    ],
    "sut_guards": [
      "endpoint_created_before_observation"
    ],
    "runtime_binding": "projection.qos_profile"
  },
  "parent_content_sha256_rule": "content_sha256 over surface_refs,target_family,logical_config,operation_windows; excludes rng_seed,repeat,run_id,domain,guid,wall time",
  "rng_seed_role": "chosen per attempt by caller; never embedded in this template"
}
